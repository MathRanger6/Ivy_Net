@article{kim_exploring_2026,
	title = {Exploring the {Too}-{Much}-{Talent} effect in academic fields: {Evidence} from the {National} {Institutes} of {Health} in the {United} {States}},
	volume = {131},
	issn = {1588-2861},
	shorttitle = {Exploring the {Too}-{Much}-{Talent} effect in academic fields},
	url = {https://doi.org/10.1007/s11192-026-05819-3},
	doi = {10.1007/s11192-026-05819-3},
	abstract = {This study investigates the Too-Much-Talent (TMT) effect, a phenomenon where additional top talents enhance team performance up to a certain point, beyond which the advantages diminish and may lead to negative outcomes, by analyzing bibliographic data and applying various statistical methods across the National Institutes of Health (NIH) institutes and centers (ICs). We analyzed bibliographic data from 56,400 articles published by NIH ICs between 2011 and 2020. Regression analyses were conducted using six functions (linear, quadratic, cubic, log, logistic, and power) and piecewise linear regression to examine the relationship between the proportion of top-talented researchers and team performance. The log function generally provided a better fit than the quadratic function across NIH ICs. At most one IC showed evidence of a TMT effect, and this effect was not statistically robust. However, employing alternative methods to assess top talent and team performance may produce different results. We expect our findings to serve as a valuable foundation for policymakers organizing or managing research teams.},
	language = {en},
	number = {11},
	urldate = {2026-10-30},
	journal = {Scientometrics},
	author = {Kim, Donghun and Zhao, Yi and Jang, Sou Hyun and Zhu, Yongjun},
	month = nov,
	year = {2026},
	keywords = {National institutes of Health, Team performance, Team science, Too-Much-Talent effect},
	pages = {8311--8327},
	file = {Full Text PDF:files/908/Kim et al. - 2026 - Exploring the Too-Much-Talent effect in academic fields Evidence from the National Institutes of He.pdf:application/pdf},
}

@article{long_never_2024,
	title = {Never {Too} {Much}—{More} talent in football (always) leads to more success},
	volume = {19},
	issn = {1932-6203},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0290147},
	doi = {10.1371/journal.pone.0290147},
	abstract = {Though it may appear counterintuitive, certain positive attributes can eventually have negative consequences when taken to an extreme. This concept is exemplified in sports, where an increase in talent among team members initially leads to improved success, but beyond a certain threshold, excessive talent can adversely affect the team. This occurrence is known as the Too Much Talent (TMT) effect, wherein status conflicts among highly skilled players can hinder team performance, particularly in sports that require coordination and cooperation. While early evidence supported the TMT effect in team sports, its validity has recently been challenged. In this study, we analyzed a comprehensive dataset consisting of 780 data points across 42 seasons from seven top European football (soccer) leagues to examine the TMT effect’s presence. Our findings reveal that football does not exhibit the TMT effect. Instead, we observed a consistent, positive correlation between the number of skilled players on a team and team success. Additionally, talent did not display diminishing returns, as its impact on success remained stable even at the highest concentrations of talent. We relate our results to existing theories and propose that future research comparing more individualistic and interdependent team sports could further enhance the field.},
	language = {en},
	number = {2},
	urldate = {2026-10-30},
	journal = {PLOS ONE},
	publisher = {Public Library of Science},
	author = {Long, Ashley M. and Graf, Mario and Bilalić, Merim},
	month = feb,
	year = {2024},
	keywords = {Algorithms, Reasoning, Research assessment, Sports, Statistical data, Statistical models, Team behavior, Universities},
	pages = {e0290147},
	file = {Full Text PDF:files/910/Long et al. - 2024 - Never Too Much—More talent in football (always) leads to more success.pdf:application/pdf},
}

@article{zell_contextual_2009,
	title = {Contextual {Neglect}, {Self}-{Evaluation}, and the {Frog}-{Pond} {Effect}},
	volume = {97},
	doi = {10.1037/a0015453},
	abstract = {Social comparisons entail not only information about one’s standing in a social group (intragroup or local comparison) but also information about the standing of the group in comparison to other groups (intergroup or general comparison). In Studies 1–3, the authors explored the relative impact of intergroup and intragroup comparisons on self-evaluations and affect. While intragroup comparison feedback consistently impacted self-evaluations and affect, intergroup comparison information exerted a significant impact only when intragroup comparison information was unavailable. The authors refer to this general tendency as contextual neglect. Studies 4 and 5 showed that contextual neglect is due primarily to the fact that low-level, local comparison information displaces or supersedes the effect of higher level, general comparison data and that people clearly recognize the superior diagnosticity of higher level comparisons while continuing to rely on small, haphazard sample data to evaluate their ability.},
	journal = {Journal of Personality and Social Psychology},
	author = {Zell, Ethan and Alicke, Mark},
	month = sep,
	year = {2009},
	pages = {467--482},
	file = {Full Text PDF:files/912/Zell and Alicke - 2009 - Contextual Neglect, Self-Evaluation, and the Frog-Pond Effect.pdf:application/pdf},
}

@article{murphy_top_2020-1,
	title = {Top of the {Class}: {The} {Importance} of {Ordinal} {Rank}},
	volume = {87},
	issn = {0034-6527},
	shorttitle = {Top of the {Class}},
	url = {https://doi.org/10.1093/restud/rdaa020},
	doi = {10.1093/restud/rdaa020},
	abstract = {This article establishes a new fact about educational production: ordinal academic rank during primary school has lasting impacts on secondary school achievement that are independent of underlying ability. Using data on the universe of English school students, we exploit naturally occurring differences in achievement distributions across primary school classes to estimate the impact of class rank. We find large effects on test scores, confidence, and subject choice during secondary school, even though these students have a new set of peers and teachers who are unaware of the students’ prior ranking in primary school. The effects are especially pronounced for boys, contributing to an observed gender gap in the number of Maths courses chosen at the end of secondary school. Using a basic model of student effort allocation across subjects, we distinguish between learning and non-cognitive skills mechanisms, finding support for the latter.},
	number = {6},
	urldate = {2026-10-30},
	journal = {The Review of Economic Studies},
	author = {Murphy, Richard and Weinhardt, Felix},
	month = nov,
	year = {2020},
	pages = {2777--2826},
	file = {Full Text PDF:files/915/Murphy and Weinhardt - 2020 - Top of the Class The Importance of Ordinal Rank.pdf:application/pdf},
}

@article{duflo_peer_2011,
