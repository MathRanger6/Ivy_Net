	isbn = {1-58487-428-7},
	abstract = {Accessing Talent: The Foundation of a U.S. Army Officer Corps Strategy, is the fourth of six monographs focused upon officer talent management in the U.S. Army. In it, Colonel Casey Wardynski, Major David S. Lyle, and Lieutenant Colonel (Ret.) Michael J. Colarusso continue their examination of how the U.S. Army accesses, develops, retains, and employs officer talent. In particular, they focus upon the ways in which dynamic labor market conditions and generational preferences have shaped service propensity among potential officer prospects. As in the previous volumes of this series, the authors first articulate a theoretical framework for improvement and then demonstrate how the application of those theories can yield desired results. In sum, they explain why a proper talent accessions strategy can create a “positive sum game” for the Army as perhaps nothing else can. Since the officer accessions process presents the Army with a dramatic opportunity to leverage talent investments made by others, the theories and programs discussed in this monograph merit thoughtful consideration.},
	author = {Wardynski, Casey and Lyle, David S. and Colarusso, Michael J.},
	year = {2010},
	note = {Publication Title: Strategy},
	keywords = {Organizations often focus their recruiting efforts},
	file = {Attachment:files/320/Lyle, Colarusso - 2010 - OFFICER CORPS STRATEGY SERIES ACCESSING TALENT CORPS STRATEGY Casey Wardynski Visit our website for other free.pdf:application/pdf},
}

