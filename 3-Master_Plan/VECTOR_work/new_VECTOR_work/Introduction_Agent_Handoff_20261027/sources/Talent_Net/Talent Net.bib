@article{sacerdote_peer_2001,
	title = {Peer {Effects} with {Random} {Assignment}: {Results} for {Dartmouth} {Roommates}},
	volume = {116},
	issn = {0033-5533},
	url = {https://academic.oup.com/qje/article-lookup/doi/10.1162/00335530151144131},
	doi = {10.1162/00335530151144131},
	abstract = {This paper uses a unique data set to measure peer effects among college roommates. Freshman year roommates and dormmates are randomly assigned at Dartmouth College. I find that peers have an impact on grade point average and on decisions to join social groups such as fraternities. Residential peer effects are markedly absent in other major life decisions such as choice of college major. Peer effects in GPA occur at the individual room level, whereas peer effects in frater- nity membership occur both at the room level and the entire dorm level. Overall, the data provide strong evidence for the existence of peer effects in student outcomes},
	number = {2},
	journal = {The Quarterly Journal of Economics},
	author = {Sacerdote, B.},
	year = {2001},
	note = {ISBN: 10.1162/00335530151144131},
	pages = {681--704},
	annote = {
This paper is focused on the way that peers INFLUENCE each other, and perhaps a bit of mentorship is involved.
Good discussion of difficulties of confounding elements, stresses the importance of random roommate assignment.

individuals self-select into groups
roommates affect each other simultaneously
difficult to distinguish empirically between peer effects that are driven by individuals' backgrounds (contextual effects) and peer effects that are driven by individuals' behavior (endogenous effects).


Need to think about the possibilities here.  On one hand officers at different levels are either randomly assigned or self-select into cohorts. Hmmm.
Peer effects have strong outcomes on some behaviors and none on others.  Fraternity membership and choice, GPA - yes.  Choice of Major - No.
The peer effect for fraternity membership is stronger at the dormitory level than at the individual room level, but the opposite is true for GPA. This provides some evidence that the reference group or relevant peer group can differ dramatically across different activities and outcomes.
Data are from a highly selective school, yet still much useful variation in the SAT scores and other background measures. This variation allows testing for the presence of interactions between roommates' backgrounds and examining the possibility for social gain through rearranging roommates
},
	file = {Attachment:files/309/Sacerdote - 2001 - Peer Effects with Random Assignment Results for Dartmouth Roommates(2).pdf:application/pdf},
}

