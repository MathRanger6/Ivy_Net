}

@article{baldwin_promotion_1996,
	title = {The {Promotion} {Record} of the {United} {States} {Army}: {Glass} {Ceilings} in the {Officer} {Corps}},
	volume = {56},
	issn = {0033-3352},
	shorttitle = {The {Promotion} {Record} of the {United} {States} {Army}},
	url = {https://www.jstor.org/stable/977208},
	doi = {10.2307/977208},
	abstract = {Are women and minorities adequately represented in the promotion processes of the U. S. Army? Are their promotion rates competitive with male and Caucasian Army officers'? What happens to female and minority promotion rates as rank increases? To answer these questions, J. Norman Baldwin presents data on more than 123,000 Caucasian, female, male, and minority Army officers considered for promotion to captain, major, lieutenant colonel, and colonel. The data indicate women and minorities are underrepresented in the Army's middle officer ranks, female officers are promoted at lower rates than male officers, and minority officers are promoted at lower rates than majority officers. Except for Native American officers, cumulative promotion rates for minorities also indicate adverse effects beginning at the rank of major and lieutenant colonel. However, noncumulative promotion rates for women and minorities generally do not indicate adverse effects, and male and Caucasian promotion rates decrease over time more than female and minority promotion rates.},
	number = {2},
	urldate = {2026-10-28},
