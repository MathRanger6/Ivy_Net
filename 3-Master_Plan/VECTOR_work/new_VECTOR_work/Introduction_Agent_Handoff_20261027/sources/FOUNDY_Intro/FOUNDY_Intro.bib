@article{gee_social_2017,
	title = {Social {Networks} and {Labor} {Markets}: {How} {Strong} {Ties} {Relate} to {Job} {Finding} on {Facebook}'s {Social} {Network}},
	volume = {35},
	issn = {0734-306X},
	url = {http://www.journals.uchicago.edu/doi/10.1086/686225},
	doi = {10.1086/686225},
	abstract = {Social networks are important for finding jobs, but which ties are most useful? Granovetter (1973) suggested that “weak ties” are more valuable than “strong ties,” since strong ties have redundant information, while weak ties have new information. Using six million Facebook users' data we find evidence for the opposite. We proxy for job help by identifying people who eventually work with a pre-existing friend. Using objective tie strength measures and our job help proxy, we find that most people are helped through one of their numerous weak ties, but a single stronger tie is significantly more valuable at the margin.},
	number = {2},
	journal = {Journal of Labor Economics},
	author = {Gee, Laura K. and Jones, Jason and Burke, Moira},
	year = {2017},
	note = {ISBN: 0734-306x},
