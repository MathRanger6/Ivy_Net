}

@article{centola_complex_2007,
	title = {Complex {Contagions} and the {Weakness} of {Long} {Ties}},
	volume = {113},
	issn = {0002-9602},
	url = {http://www.journals.uchicago.edu/doi/10.1086/521848},
	doi = {10.1086/521848},
	abstract = {The strength of weak ties is that they tend to be long—they connect socially distant locations, allowing information to diffuse rapidly. The authors test whether this “strength of weak ties” generalizes from simple to complex contagions. Complex contagions require social affirmation from multiple sources. Examples include the spread of high-risk social movements, avant garde fashions, and unproven technologies. Results show that as adoption thresholds increase, long ties can impede diffusion. Complex contagions depend primarily on the width of the bridges across a network, not just their length. Wide bridges are a characteristic feature of many spatial networks, which may account in part for the widely observed ten- dency for social movements to diffuse spatially.},
	number = {3},
	journal = {American Journal of Sociology},
	author = {Centola, Damon and Macy, Michael},
